# ─────────────────────────────────────────────────────────────────────────────
# .env.staging.example — copy to .env and fill in real staging values.
# NEVER commit the real .env file. Placeholder values only — no working keys,
# passwords, or tokens.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-output-of-get_random_secret_key

# ── Database (MySQL) ──────────────────────────────────────────────────────────
DB_NAME=barangay_cctv_staging
DB_USER=barangay_user
DB_PASSWORD=replace-with-strong-password
DB_ROOT_PASSWORD=replace-with-strong-root-password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# ── Hosts — required by config.settings.staging (no wildcards) ────────────────
ALLOWED_HOSTS=staging.aeris.example.com,localhost

# ── CORS — staging frontend origin(s) ─────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://staging.aeris.example.com

# Required by Django 4+ for any POST/PUT/PATCH made through the HTTPS origin.
CSRF_TRUSTED_ORIGINS=https://staging.aeris.example.com

# ── AI Service ────────────────────────────────────────────────────────────────
AI_SERVICE_API_KEY=replace-with-random-key
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8005

# ── YOLO model ────────────────────────────────────────────────────────────────
YOLO_MODEL_PATH=yolo11n.pt
DEFAULT_CONF_THRESHOLD=0.5
DEVICE=cpu

# ── HTTPS ─────────────────────────────────────────────────────────────────────
USE_HTTPS=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ── Cloudinary media storage (optional) ───────────────────────────────────────
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-pem-on-one-line
VAPID_CLAIMS_SUB=mailto:staging@example.com

# ── Transactional email (Brevo API v3) ───────────────────────────────────────
BREVO_API_KEY=replace-with-brevo-api-key
DEFAULT_FROM_EMAIL=Aeris Staging <staging@example.com>

# ── Public app origin (used by outbound email) ───────────────────────────────
PUBLIC_APP_URL=https://staging.aeris.example.com

# ── Internal service key (used by /internal/ endpoints) ──────────────────────
INTERNAL_API_KEY=replace-with-random-key

# ── Image tag — set to :staging (CI/CD pushes :staging to this branch) ───────
AERIS_TAG=staging
AERIS_IMAGE_PREFIX=ghcr.io/lvly-00/project-aeris

# ── Default admin account (seed_default_admin) ────────────────────────────────
ADMIN_EMAIL=staging-admin@example.com
ADMIN_PASSWORD=replace-with-strong-admin-password

# ── Seed operator / tanod accounts (seed_users) ───────────────────────────────
SEED_USERS_PASSWORD=replace-with-strong-seed-password
