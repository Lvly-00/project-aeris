# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values before running.
# NEVER commit the real .env file.  This file should contain only placeholder
# values — no working keys, passwords, or tokens.
#
# Generate a Django secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
# REQUIRED — generate a unique key per environment, never reuse across envs
SECRET_KEY=replace-with-output-of-get_random_secret_key

# ── Database (MySQL) ──────────────────────────────────────────────────────────
DB_NAME=barangay_cctv
DB_USER=barangay_user
DB_PASSWORD=replace-with-strong-password
DB_ROOT_PASSWORD=replace-with-strong-root-password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# ── CORS — list your actual frontend origin(s), no wildcards in production ────
CORS_ALLOWED_ORIGINS=https://your-domain.com

# ── AI Service ────────────────────────────────────────────────────────────────
# REQUIRED — change from the default before deploying; used for service-to-service auth
AI_SERVICE_API_KEY=replace-with-random-key
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8005

# ── YOLO model ────────────────────────────────────────────────────────────────
YOLO_MODEL_PATH=yolo11n.pt
DEFAULT_CONF_THRESHOLD=0.5
DEVICE=cpu

# ── HTTPS (set True once TLS is terminated at nginx) ─────────────────────────
USE_HTTPS=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# ── Internal service key (used by /internal/ endpoints) ──────────────────────
INTERNAL_API_KEY=replace-with-random-key

# ── Desktop mode (Electron) ───────────────────────────────────────────────────
# DESKTOP_MODE=True
# DESKTOP_DB_DIR=/path/to/db
# DESKTOP_MEDIA_DIR=/path/to/media
# DESKTOP_FRONTEND_DIR=/path/to/frontend/dist
