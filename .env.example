# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values before running.
# NEVER commit the real .env file.  This file should contain only placeholder
# values — no working keys, passwords, or tokens.
#
# Generate a Django secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────────────────────
# REQUIRED — generate a unique key per environment, never reuse across envs
SECRET_KEY=replace-with-output-of-get_random_secret_key

# ── Database (MySQL) ──────────────────────────────────────────────────────────
DB_NAME=barangay_cctv
DB_USER=barangay_user
DB_PASSWORD=replace-with-strong-password
DB_ROOT_PASSWORD=replace-with-strong-root-password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# ── Hosts — required by config.settings.production (no wildcards) ────────────
ALLOWED_HOSTS=your-domain.com,localhost

# ── CORS — list your actual frontend origin(s), no wildcards in production ────
CORS_ALLOWED_ORIGINS=https://your-domain.com

# Required by Django 4+ for any POST/PUT/PATCH made through the HTTPS origin.
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# ── AI Service ────────────────────────────────────────────────────────────────
# REQUIRED — change from the default before deploying; used for service-to-service auth
AI_SERVICE_API_KEY=replace-with-random-key
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8005

# ── YOLO model ────────────────────────────────────────────────────────────────
YOLO_MODEL_PATH=yolo11n.pt
DEFAULT_CONF_THRESHOLD=0.5
DEVICE=cpu

# ── HTTPS (set True once TLS is terminated at nginx) ─────────────────────────
USE_HTTPS=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

# ── Cloudinary media storage (optional) ──────────────────────────────────────
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Leave blank to keep uploads on the local media volume served by nginx.
CLOUDINARY_URL=

# ── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate key pair with:
#   python -c "from py_vapid import Vapid; v = Vapid(); v.generate_keys(); print(v.private_pem().decode())"
# Public key is the uncompressed EC point, base64url-encoded (no padding).
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-pem-on-one-line
VAPID_CLAIMS_SUB=mailto:your-email@example.com

# ── Internal service key (used by /internal/ endpoints) ──────────────────────
INTERNAL_API_KEY=replace-with-random-key

# ── Desktop mode (Electron) ───────────────────────────────────────────────────
# DESKTOP_MODE=True
# DESKTOP_DB_DIR=/path/to/db
# DESKTOP_MEDIA_DIR=/path/to/media
# DESKTOP_FRONTEND_DIR=/path/to/frontend/dist

# ── Default admin account (seed_default_admin) ────────────────────────────────
# REQUIRED — credentials for the primary System Administrator account that is
# created on first deploy.  ADMIN_PASSWORD must satisfy the project's
# ComplexityPasswordValidator: 8+ chars, uppercase, lowercase, digit, special.
ADMIN_EMAIL=replace-with-admin-email@example.com
ADMIN_PASSWORD=replace-with-strong-admin-password

# Optional extra admin accounts (repeat block for each, incrementing N):
# EXTRA_ADMIN_1_EMAIL=replace-with-email@example.com
# EXTRA_ADMIN_1_FIRST_NAME=FirstName
# EXTRA_ADMIN_1_LAST_NAME=LastName
# EXTRA_ADMIN_2_EMAIL=replace-with-email@example.com
# EXTRA_ADMIN_2_FIRST_NAME=FirstName
# EXTRA_ADMIN_2_LAST_NAME=LastName
