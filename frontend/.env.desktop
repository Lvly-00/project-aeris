# Desktop mode — Electron app (LOCAL dev). The packaged installer connects to
# the server URL baked at build time (electron/server-url.json via
# scripts/write-server-url.cjs / scripts\build-desktop.ps1) — NOT this file.
VITE_APP_TARGET=desktop
# Local development backend
VITE_BACKEND_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
VITE_WS_BACKEND_URL=ws://localhost:8000
# AI service runs locally on the desktop (dev); /ai is proxied here by Vite
VITE_AI_URL=http://localhost:8005