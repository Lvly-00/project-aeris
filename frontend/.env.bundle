# Bundled desktop build (scripts\build-desktop.ps1 builds with `--mode bundle`).
#
# The ai-service serves BOTH the SPA and /ai on one local origin
# (http://localhost:8005). The API and WebSocket always target the deployed
# backend here. For fully-local testing use dev mode instead, or rerun the
# build with -Local so the backend points at http://localhost:8000.
VITE_APP_TARGET=desktop
VITE_BACKEND_URL=https://project-aeris.onrender.com
VITE_API_URL=https://project-aeris.onrender.com
VITE_WS_BACKEND_URL=wss://project-aeris.onrender.com